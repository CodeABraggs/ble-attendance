<?xml version="1.0" encoding="utf-8"?>
<!-- The login token must not be restored or transferred onto another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
